--- /dev/null
+++ b/scripts/portable-pack-audit-policy.ts
@@ -0,0 +1,13 @@
+/** Keep drive letters out of tar's archive operand: GNU tar treats C: as a remote host. */
+export const packAuditTarInvocation = (
+  directory: string,
+  filename: string,
+  action: "list" | "extract",
+): { cwd: string; args: string[] } => {
+  // npm pack reports a local basename. Refuse paths before listing/extracting;
+  // ./ also prevents a basename from being interpreted as an option.
+  if (!filename.endsWith(".tgz") || /[\\/:\p{Cc}]/u.test(filename)) {
+    throw new Error("npm pack archive must be a local tgz basename");
+  }
+  return { cwd: directory, args: [action === "list" ? "-tzf" : "-xzf", `./${filename}`] };
+};
