new file mode 100644
index 0000000..56d7a28
--- /dev/null
+++ b/tests/child-approval-context.unit.test.ts
@@ -0,0 +1,44 @@
+import { Context } from "@deepseek-ai/cordis";
+import type { Agent } from "@deepseek-ai/dsh-agent";
+import { SessionId, SessionStore } from "@deepseek-ai/dsh-session";
+import { SystemPrompt } from "@deepseek-ai/dsh-system-prompt";
+import { ApprovalService, setApprovalPolicy } from "@deepseek-ai/dsh-user-approval";
+import { afterEach, expect, it } from "vitest";
+import { installHostChildApprovalContext } from "../packages/runtime-product/src/system-context.js";
+
+const roots: Context[] = [];
+afterEach(async () => {
+  await Promise.all(roots.splice(0).map((root) => root.fiber.dispose()));
+});
+
+it("projects actual child ask/never policy without changing policy, other contexts or root prompts", async () => {
+  const root = new Context();
+  roots.push(root);
+  await root.plugin(SessionStore);
+  await root.plugin(SystemPrompt, { includeHarnessIdentity: false });
+  await root.plugin(ApprovalService, { policy: "ask" });
+  const parent = { session: root.sessions.create(SessionId("parent")) } as Agent;
+  const child = { session: root.sessions.create(SessionId("child"), {
+    meta: { origin: "subagent", parentSession: parent.session.id },
+  }) } as Agent;
+  root.systemPrompt.context({ name: "subagent:delegation", order: 1, text: "original fixed delegation" });
+  root.systemPrompt.context({ name: "host:literal", order: 2, text: "operations that require approval are rejected automatically {{literal}}" });
+  const stop = installHostChildApprovalContext(root);
+  const assemble = (agent: Agent) => root.systemPrompt.assemble({ agent, scope: agent });
+  const text = async (agent: Agent) => (await assemble(agent)).contexts.find(({ name }) => name === "subagent:delegation")?.text;
+
+  expect(await text(parent)).toBe("original fixed delegation");
+  expect(await text(child)).toContain("configured Host answerers");
+  expect(await text(child)).not.toContain("operations that require approval are rejected automatically");
+  expect(root.approval.overrideOf(child.session)).toBeUndefined();
+  setApprovalPolicy(child.session, "never");
+  expect(await text(child)).toContain("operations that require approval are rejected automatically");
+  expect(root.approval.overrideOf(child.session)).toBe("never");
+  setApprovalPolicy(child.session, "ask");
+  expect(await text(child)).toContain("configured Host answerers");
+  expect((await assemble(child)).contexts.find(({ name }) => name === "host:literal")?.text)
+    .toBe("operations that require approval are rejected automatically {{literal}}");
+  expect(root.approval.overrideOf(parent.session)).toBeUndefined();
+  stop();
+  expect(await text(child)).toBe("original fixed delegation");
+});
