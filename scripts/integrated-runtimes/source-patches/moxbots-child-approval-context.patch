+import assert from "node:assert/strict";
+import { readFileSync, realpathSync } from "node:fs";
+import { createRequire } from "node:module";
+import { join, resolve } from "node:path";
+
+import { Context } from "@deepseek-ai/cordis";
+import { CommandRuntime } from "@deepseek-ai/dsh-commands";
+import { z } from "zod";
+
+const repository = resolve(import.meta.dirname, "..");
+const consumer = process.argv[2];
+if (!consumer) throw new Error("usage: verify-isolated-dsh-identities <consumer>");
+const rootRequire = createRequire(join(repository, "package.json"));
+const consumerRequire = createRequire(join(consumer, "package.json"));
+const inventory = JSON.parse(readFileSync(join(consumer, "package.json"), "utf8")) as { dependencies: Record<string, string> };
+assert.equal(realpathSync(consumerRequire.resolve("@deepseek-ai/cordis")), realpathSync(rootRequire.resolve("@deepseek-ai/cordis")));
+assert.equal(realpathSync(consumerRequire.resolve("zod")), realpathSync(rootRequire.resolve("zod")));
+let count = 0;
+for (const name of Object.keys(inventory.dependencies)) {
+  if (!name.startsWith("@deepseek-ai/dsh-") && !name.startsWith("@deepseek-ai/cdp")) continue;
+  const nativeRequire = createRequire(join(consumer, "node_modules", name, "package.json"));
+  assert.equal(realpathSync(nativeRequire.resolve("@deepseek-ai/cordis")), realpathSync(rootRequire.resolve("@deepseek-ai/cordis")), "Cordis public Context identity split");
+  assert.equal(realpathSync(nativeRequire.resolve("zod")), realpathSync(rootRequire.resolve("zod")), "Zod public identity split");
+  count++;
+}
+const ctx = new Context();
+new CommandRuntime(ctx);
+assert.equal(Object.hasOwn(ctx.reflect.props, "invocation"), true, "Native Typert invocation accessor must bind the public Context");
+assert.equal(z.object({ accepted: z.literal(true) }).parse({ accepted: true }).accepted, true);
+process.stdout.write(`Verified public Cordis/Zod identities and native Typert accessor for ${count} native packages\n`);
