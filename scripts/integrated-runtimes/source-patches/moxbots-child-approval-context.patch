+/** Project the policy owned by this composition through DSH's public assembly seam. */
+export const installHostChildApprovalContext = (root: Context): (() => void) =>
+  root.on("system-prompt/assemble", async (_assembly, context, next) => {
+    const assembly = await next();
+    const agent = context.agent;
+    if (agent?.session.header.origin !== "subagent"
+      || agent.session.header.parentSession === undefined) return assembly;
+    const policy = root.approval.overrideOf(agent.session) ?? root.approval.config.policy ?? "ask";
+    const text = policy === "ask"
+      ? "You are a delegated subagent. Operations that require approval are routed through the configured Host answerers under the current Session policy; without an available answerer, the request fails closed. A denied operation must not be retried to evade its decision. Delegation itself does not grant additional access; report any remaining limitation to the delegating agent."
+      : "You are a delegated subagent. The current Session approval policy is never: operations that require approval are rejected automatically. Do not retry a denied operation or widen your scope; report the limitation to the delegating agent.";
+    return { ...assembly, contexts: assembly.contexts.map((entry) =>
+      entry.name === "subagent:delegation" ? { ...entry, text } : entry) };
+  });
