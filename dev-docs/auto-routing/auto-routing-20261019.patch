+
+  it('has no wall-clock deadline and stops only on cancel', async () => {
+    expect(cliRequestTimeoutMs('route/assist')).toBe(10_000);
+    expect(isUnboundedCliRoute('route/assist')).toBe(true);
+    const controller = new AbortController();
