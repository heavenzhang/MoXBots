@@ -0,0 +1,241 @@
+// Auto-route service: the tier table from the effective provider catalog, the
+// classifier singleton, and one `routeTurn()` used by turn admission and by
+// `route explain`. Nothing here changes a Session; callers apply the result.
+
+import {
+  autoModelKey,
+  buildAutoTierTable,
+  decideAutoRoute,
+  findAutoTierEntry,
+  fitEffort,
+  isAutoRoutingEnabled,
+  isNonChatModel,
+  isAutoTier,
+  parseAutoRoutingSettings,
+  pickAutoClassifier,
+  type AutoModelRef,
+  type AutoRouteDecision,
+  type AutoRouteReason,
+  type AutoRoutingSettings,
+  type AutoTier,
+  type AutoTierCandidate,
+  type AutoTierEntry,
+  type AutoTierTable,
+} from '../../shared/autoRoute';
+import type { AppConfig, ModelEntity, Provider } from '../../shared/config-types';
+import { isRuntimeBackedProvider } from '../../shared/providerExecution';
+import { createConcreteProviderRoute } from '../../shared/providerRoute';
+import { reasoningEffortChoices } from '../../shared/reasoningEffort';
+import { canResumeAcrossBuiltinProviderHistory } from '../builtin-session/config';
+import type { ProviderEnv } from '../provider-types';
+import {
+  getAllEffectiveProviders,
+  getProviderSelectionError,
+  loadConfig,
+  materializeProviderRouteEnv,
+  resolveSubscriptionAuthKind,
+  type AdminAppConfig,
+} from '../utils/admin-config';
+import { lookupModelCapability, lookupProviderModelContextLength } from '../utils/model-capabilities';
+import { createAutoRouteClassifier, type AutoRouteClassifier, type ClassifyOutcome } from './classifier';
+
+/** One routable model and what it takes to run it. */
+export interface AutoRouteCatalogEntry extends AutoTierCandidate {
+  provider: Provider;
+}
+
+export interface AutoRouteCatalog {
+  settings: AutoRoutingSettings;
+  table: AutoTierTable;
+  entries: Map<string, AutoRouteCatalogEntry>;
+}
+
+/**
+ * Providers that can take an auto-routed turn: enabled, builtin-executable,
+ * selectable (credential / verified subscription). Runtime-backed providers
+ * (Codex subscription) run their own Runtime and never join a builtin Session.
+ */
+function routableProviders(config: AdminAppConfig): Provider[] {
+  return (getAllEffectiveProviders(config) as unknown as Provider[]).filter(provider =>
+    provider.enabled !== false
+    && !provider.id.startsWith('cloud-session:')
+    && !isRuntimeBackedProvider(provider)
+    && getProviderSelectionError(provider as unknown as Parameters<typeof getProviderSelectionError>[0], config) === null);
+}
+
+export function buildAutoRouteCatalog(config: AdminAppConfig = loadConfig()): AutoRouteCatalog {
+  const settings = parseAutoRoutingSettings((config as unknown as AppConfig).autoRouting);
+  const entries = new Map<string, AutoRouteCatalogEntry>();
+  for (const provider of routableProviders(config)) {
+    for (const entity of (provider.models ?? []) as ModelEntity[]) {
+      if (!entity?.model || isNonChatModel(entity.model)) continue;
+      const capability = lookupModelCapability(entity.model);
+      const candidate: AutoRouteCatalogEntry = {
+        provider,
+        providerId: provider.id,
+        model: entity.model,
+        modelName: entity.modelName,
+        ...(isAutoTier(entity.tier) ? { catalogTier: entity.tier } : {}),
+        ...(capability?.outputCostPerMillion !== undefined ? { outputCostPerMillion: capability.outputCostPerMillion } : {}),
+        contextLength: entity.contextLength ?? lookupProviderModelContextLength(entity.model, provider.id),
+      };
+      entries.set(autoModelKey(candidate), candidate);
+    }
+  }
+  return { settings, table: buildAutoTierTable([...entries.values()], settings), entries };
+}
+
+/** Provider env the Session would run this model with; 'subscription' for SDK-native. */
+export function resolveAutoRouteEnv(
+  ref: AutoModelRef,
+  config?: AdminAppConfig,
+): ProviderEnv | 'subscription' | undefined {
+  const route = createConcreteProviderRoute(ref.providerId, ref.model);
+  if (route.kind === 'subscription' && resolveSubscriptionAuthKind(ref.providerId, config) === 'sdk-native') {
+    return 'subscription';
+  }
+  return materializeProviderRouteEnv(route, config);
+}
+
+export function autoRouteEffort(entry: AutoRouteCatalogEntry | undefined, tier: AutoTier): string | undefined {
+  if (!entry) return undefined;
+  return fitEffort(tier, reasoningEffortChoices(
+    'builtin', entry.provider.apiProtocol, entry.provider.id, entry.model, entry.provider.config?.baseUrl,
+  ));
+}
+
+let sharedClassifier: AutoRouteClassifier | undefined;
+
+/** Process-wide classifier with the real transport, created on first use. */
+export async function getAutoRouteClassifier(): Promise<AutoRouteClassifier> {
+  if (sharedClassifier) return sharedClassifier;
+  const [{ createClassifierTransport }, proxy, port, agentSession, titles] = await Promise.all([
+    import('./transport'),
+    import('../proxy-state'),
+    import('../session-core/sidecar-port'),
+    import('../agent-session'),
+    import('../title-generator'),
+  ]);
+  sharedClassifier ??= createAutoRouteClassifier(createClassifierTransport({
+    resolveEnv: (providerId, model) => resolveAutoRouteEnv({ providerId, model }),
+    getProxyForProviderUrl: proxy.getProxyForProviderUrl,
+    getSidecarPort: port.getSidecarPort,
+    startOneShotBridge: (env, model, description) => agentSession.startOneShotBridge(env, model, description),
+    generateUtilityText: (task, model, env) => titles.generateUtilityText(task, model, env),
+  }));
+  return sharedClassifier;
+}
+
+export interface RouteTurnInput {
+  text: string;
+  previousUser?: string;
+  previousReply?: string;
+  previousTier?: AutoTier;
+  /** The Session's current model and env; candidates must share its provider history. */
+  current?: AutoModelRef;
+  currentEnv?: ProviderEnv;
+  lastTurnAt?: number;
+  contextUsed?: number;
+  /** No conversation yet, so any provider history is acceptable. */
+  freshHistory?: boolean;
+  /** Extra per-turn requirement, e.g. image input. */
+  accept?: (ref: AutoModelRef) => boolean;
+  signal?: AbortSignal;
+}
+
+export interface RouteTurnResult {
+  decision: AutoRouteDecision;
+  effort?: string;
+  classifier?: AutoModelRef;
+  classify?: ClassifyOutcome;
+  latencyMs: number;
+}
+
+/**
+ * Classify a new turn and choose its model. Returns null when auto routing is
+ * off or nothing is routable; the turn then runs on the current model.
+ */
+export async function routeTurn(
+  input: RouteTurnInput,
+  deps: {
+    catalog?: AutoRouteCatalog;
+    classifier?: AutoRouteClassifier;
+    now?: () => number;
+    config?: AdminAppConfig;
+  } = {},
+): Promise<RouteTurnResult | null> {
+  const now = deps.now ?? Date.now;
+  const started = now();
+  const config = deps.config ?? loadConfig();
+  const catalog = deps.catalog ?? buildAutoRouteCatalog(config);
+  if (!isAutoRoutingEnabled(catalog.settings)) return null;
+
+  const envCache = new Map<string, ProviderEnv | 'subscription' | undefined>();
+  const envFor = (ref: AutoModelRef) => {
+    const key = autoModelKey(ref);
+    if (!envCache.has(key)) envCache.set(key, resolveAutoRouteEnv(ref, config));
+    return envCache.get(key);
+  };
+  // Switching across provider history identities starts a fresh SDK session
+  // (the conversation would be lost), so auto routing never does it.
+  const isUsable = (entry: AutoTierEntry) => {
+    if (input.accept && !input.accept(entry)) return false;
+    const env = envFor(entry);
+    if (!env) return false;
+    if (input.freshHistory) return true;
+    // An existing conversation is checked even when the current model is
+    // unknown (Session default): its env still fixes the history identity.
+    return canResumeAcrossBuiltinProviderHistory({
+      currentProviderEnv: input.currentEnv,
+      currentModel: input.current?.model,
+      nextProviderEnv: env === 'subscription' ? undefined : env,
+      nextModel: entry.model,
+    });
+  };
+
+  const currentEntry = findAutoTierEntry(catalog.table, input.current);
+  const classifierRef = pickAutoClassifier(catalog.table, catalog.settings, input.current);
+  let tier: AutoTier | undefined;
+  let verdict: 'classified' | 'cached' | 'fallback-previous' | 'classifier-failed' = 'classifier-failed';
+  let classify: ClassifyOutcome | undefined;
+  if (classifierRef) {
+    const engine = deps.classifier ?? await getAutoRouteClassifier();
+    classify = await engine.classify(classifierRef, {
+      text: input.text,
+      previousUser: input.previousUser,
+      previousReply: input.previousReply,
+      previousTier: input.previousTier,
+    }, input.signal);
+    if (classify.ok) {
+      tier = classify.tier;
+      verdict = classify.cached ? 'cached' : 'classified';
+    }
+  }
+  if (!tier) {
+    // Magpie `Fallback: previous`: a failed judgement keeps the last tier.
+    tier = input.previousTier ?? currentEntry?.tier;
+    verdict = input.previousTier || currentEntry ? 'fallback-previous' : 'classifier-failed';
+  }
+
+  const decision = decideAutoRoute({
+    table: catalog.table,
+    tier,
+    verdict,
+    current: input.current,
+    lastTurnAt: input.lastTurnAt,
+    now: now(),
+    contextUsed: input.contextUsed,
+    isUsable,
+  });
+  if (!decision) return null;
+  const target = catalog.entries.get(autoModelKey(decision.target));
+  return {
+    decision,
+    effort: autoRouteEffort(target, decision.tier),
+    ...(classifierRef ? { classifier: classifierRef } : {}),
+    ...(classify ? { classify } : {}),
+    latencyMs: now() - started,
+  };
+}
+
+export type { AutoRouteReason };
diff --git a/src/server/auto-route/session-state.ts b/src/server/auto-route/session-state.ts
new file mode 100644
index 000000000..fffc85265
--- /dev/null
+++ b/src/server/auto-route/session-state.ts
@@ -0,0 +1,37 @@
+// In-memory auto-route state per Product Session: the tier the last routed
+// turn ran on and the next model in that tier for failover. Leaf module with
+// no imports so agent-session can read it without an import cycle.
+
+export interface AutoRouteBackupRef {
+  providerId: string;
+  modelId: string;
+}
+
+interface AutoRouteSessionState {
+  tier?: 'fast' | 'balanced' | 'strong';
+  backup?: AutoRouteBackupRef;
+}
+
+const states = new Map<string, AutoRouteSessionState>();
+const MAX_SESSIONS = 256;
+
+export function setAutoRouteSessionState(sessionId: string, state: AutoRouteSessionState | undefined): void {
+  states.delete(sessionId);
+  if (!state) return;
+  states.set(sessionId, state);
+  // Insertion order is recency; drop the oldest beyond the cap.
+  while (states.size > MAX_SESSIONS) {
+    const oldest = states.keys().next().value;
+    if (oldest === undefined) break;
+    states.delete(oldest);
+  }
+}
+
+export function getAutoRouteSessionState(sessionId: string): AutoRouteSessionState | undefined {
+  return states.get(sessionId);
+}
+
+/** Failover backup chosen by auto routing for this Session's current turn. */
+export function getAutoRouteBackup(sessionId: string): AutoRouteBackupRef | undefined {
+  return states.get(sessionId)?.backup;
+}
diff --git a/src/server/auto-route/transport.ts b/src/server/auto-route/transport.ts
new file mode 100644
index 000000000..b224e0514
--- /dev/null
+++ b/src/server/auto-route/transport.ts
@@ -0,0 +1,142 @@
+// Classifier transport: the fastest path that is byte-equivalent to how the
+// Session itself reaches the provider.
+//
+//   - Anthropic-protocol API key → direct `/v1/messages` (undici, provider
+//     proxy policy, no redirects). No SDK subprocess, so no spawn latency.
+//   - OpenAI-protocol → the loopback one-shot Bridge, which owns translation,
+//     token-param naming and the upstream proxy exactly as a real turn does.
+//   - Managed credentials, endpoints and the SDK-native subscription → the
+//     isolated SDK utility turn (`generateUtilityText`), the only path that
+//     can resolve those bearers.
+
+import { fetch as undiciFetch, ProxyAgent, type Dispatcher } from 'undici';
+
+import { anthropicAuthHeaders, joinAnthropicMessagesUrl } from '../provider-probe';
+import { opencodeGoConversationId, opencodeGoHeaders } from '../opencode-go-request';
+import { TOKENDANCE_APP_URL, TOKENDANCE_PROVIDER_ID } from '../../shared/tokendance';
+import type { ProviderEnv } from '../provider-types';
+import { ClassifierTransportError, type ClassifierTransport, type ClassifierTransportRequest } from './classifier';
+
+/** Room for a reasoning model to think before the number (Magpie: 2048). */
+const CLASSIFIER_MAX_TOKENS = 2048;
+const ANTHROPIC_VERSION = '2023-06-01';
+const ERROR_BODY_MAX = 300;
+
+export interface ClassifierTransportDeps {
+  /** Provider env for a model, or 'subscription' for the SDK-native one; undefined when unusable. */
+  resolveEnv: (providerId: string, model: string) => ProviderEnv | 'subscription' | undefined;
+  getProxyForProviderUrl: (providerId: string, url: string) => string | undefined;
+  getSidecarPort: () => number;
+  startOneShotBridge: (providerEnv: ProviderEnv, model: string, description: string) => { token: string; release: () => void };
+  generateUtilityText: (
+    task: { prompt: string; systemPrompt: string; clean: (text: string) => string | null; signal?: AbortSignal },
+    model: string,
+    providerEnv?: ProviderEnv,
+  ) => Promise<string | null>;
+}
+
+function messagesBody(request: ClassifierTransportRequest): string {
+  return JSON.stringify({
+    model: request.classifier.model,
+    max_tokens: CLASSIFIER_MAX_TOKENS,
+    temperature: 0,
+    system: request.system,
+    messages: [{ role: 'user', content: request.prompt }],
+  });
+}
+
+/** Text of an Anthropic Messages response; thinking blocks are skipped. */
+export function readMessagesText(payload: unknown): string {
+  const content = (payload as { content?: unknown } | null)?.content;
+  if (!Array.isArray(content)) return '';
+  return content
+    .filter((block): block is { type: 'text'; text: string } =>
+      !!block && typeof block === 'object' && (block as { type?: unknown }).type === 'text'
+      && typeof (block as { text?: unknown }).text === 'string')
+    .map(block => block.text)
+    .join('\n');
+}
+
+async function readResponse(resp: { ok: boolean; status: number; text: () => Promise<string> }): Promise<string> {
+  const body = await resp.text();
+  if (!resp.ok) {
+    throw new ClassifierTransportError(`classifier HTTP ${resp.status}: ${body.slice(0, ERROR_BODY_MAX)}`);
+  }
+  try {
+    return readMessagesText(JSON.parse(body));
+  } catch {
+    throw new ClassifierTransportError('classifier returned a body that is not JSON');
+  }
+}
+
+function asTransportError(error: unknown): ClassifierTransportError {
+  if (error instanceof ClassifierTransportError) return error;
+  const cause = error instanceof Error ? (error as Error & { cause?: unknown }).cause : undefined;
+  const message = error instanceof Error ? error.message : String(error);
+  const causeMessage = cause instanceof Error ? cause.message : '';
+  return new ClassifierTransportError(causeMessage ? `${message} (${causeMessage})` : message);
+}
+
+export function createClassifierTransport(deps: ClassifierTransportDeps): ClassifierTransport {
+  return async (request) => {
+    const { providerId, model } = request.classifier;
+    const env = deps.resolveEnv(providerId, model);
+    if (!env) throw new ClassifierTransportError(`classifier provider "${providerId}" is unavailable or has no credential`);
+
+    // Managed bearers and the SDK-native subscription only resolve inside an SDK turn.
+    if (env === 'subscription' || env.credentialSource || env.endpointSource || !env.apiKey) {
+      const text = await deps.generateUtilityText(
+        { prompt: request.prompt, systemPrompt: request.system, clean: value => value.trim() || null, signal: request.signal },
+        model,
+        env === 'subscription' ? undefined : env,
+      );
+      if (request.signal.aborted) throw new ClassifierTransportError('classifier timed out');
+      if (text === null) throw new ClassifierTransportError('classifier utility turn returned nothing');
+      return text;
+    }
+
+    try {
+      if (env.apiProtocol === 'openai') {
+        const port = deps.getSidecarPort();
+        if (port <= 0) throw new ClassifierTransportError('sidecar port unavailable');
+        const bridge = deps.startOneShotBridge(env, model, `auto-route-classifier:${env.baseUrl ?? ''}`);
+        try {
+          const resp = await fetch(`http://127.0.0.1:${port}/bridge/${bridge.token}/v1/messages`, {
+            method: 'POST',
+            headers: { 'content-type': 'application/json', 'x-api-key': env.apiKey, 'anthropic-version': ANTHROPIC_VERSION },
+            body: messagesBody(request),
+            signal: request.signal,
+          });
+          return await readResponse(resp);
+        } finally {
+          bridge.release();
+        }
+      }
+
+      if (!env.baseUrl) throw new ClassifierTransportError('classifier provider has no base URL');
+      const url = joinAnthropicMessagesUrl(env.baseUrl);
+      const proxyUrl = deps.getProxyForProviderUrl(providerId, url);
+      const agent = proxyUrl ? new ProxyAgent(proxyUrl) : undefined;
+      try {
+        const init: Parameters<typeof undiciFetch>[1] & { dispatcher?: Dispatcher } = {
+          method: 'POST',
+          headers: {
+            ...anthropicAuthHeaders(env.authType, env.apiKey),
+            ...(providerId === TOKENDANCE_PROVIDER_ID ? { 'X-App-URL': TOKENDANCE_APP_URL } : {}),
+            ...opencodeGoHeaders(providerId, opencodeGoConversationId(undefined)),
+          },
+          body: messagesBody(request),
+          signal: request.signal,
+          // A user-configured base URL may be local; a redirect to elsewhere is refused.
+          redirect: 'error',
+          ...(agent ? { dispatcher: agent } : {}),
+        };
+        return await readResponse(await undiciFetch(url, init));
+      } finally {
+        if (agent) await agent.close().catch(() => {});
+      }
+    } catch (error) {
+      throw asTransportError(error);
+    }
+  };
+}
